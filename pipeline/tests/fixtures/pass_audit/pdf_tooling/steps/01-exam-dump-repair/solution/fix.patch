+def plain(text):
+    """متن را برای مقایسه ساده می‌کند: بی‌نویسهٔ نامرئی، فاصلهٔ معمولی، رقم لاتین."""
+    keep = [" " if c.isspace() else str(unicodedata.digit(c))
+            if unicodedata.category(c) == "Nd" else c
+            for c in text if unicodedata.category(c) != "Cf"]
+    return re.sub(r" +", " ", "".join(keep)).strip()
+
+
+def number_of(text):
+    """عدد «شمارهٔ سؤال» یا None."""
+    t = plain(text)
+    if len(t) < 2:
+        return None
+    t = (t[1:] if t[0] in DASHES else t[:-1] if t[-1] in DASHES else "").strip()
+    return int(t) if t.isdigit() and t.isascii() else None
+
+
+def fix_question_numbers(doc):
+    """شماره‌ها را «اول عدد، بعد خط تیره» می‌کند و آخرین شماره را برمی‌گرداند."""
+    want = last = 0
+    for page in doc["pages"]:
+        for line in lines(page):
+            for size in (1, 2):
+                if size > len(line):
+                    break
+                n = number_of("".join(s["text"] for s in line[:size]))
+                if n is None:
+                    continue
+                if want and n != want:
+                    break
+                head = line[:size]
+                new = dict(head[0], text=fa(n) + "-",
+                           x0=min(float(s["x0"]) for s in head),
+                           x1=max(float(s["x1"]) for s in head))
+                drop = {id(s) for s in head}
+                page["spans"] = [s for s in page["spans"]
+                                 if id(s) not in drop] + [new]
+                last, want = n, n + 1
+                break
+    return last
+
+
+def drop_bonus_notes(doc):
+    """خط‌هایی را که می‌گویند فلان سؤال‌ها امتیازی‌اند برمی‌دارد."""
+    for page in doc["pages"]:
+        drop = {id(s) for line in lines(page)
+                if BONUS.search(plain(line_text(line))) for s in line}
+        page["spans"] = [s for s in page["spans"] if id(s) not in drop]
+
