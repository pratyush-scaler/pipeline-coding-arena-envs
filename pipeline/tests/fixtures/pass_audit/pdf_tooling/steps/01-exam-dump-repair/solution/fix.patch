+def spread(widths, row):
+    """یک ردیف را از لبهٔ راست تا لبهٔ چپ با فاصله‌های مساوی پخش می‌کند."""
+    gap = (OPTION_RIGHT - OPTION_LEFT - sum(widths)) / (len(widths) - 1)
+    out, x = [], OPTION_RIGHT
+    for w in widths:
+        out.append((x - w, x, row))
+        x = x - w - gap
+    return out
+
